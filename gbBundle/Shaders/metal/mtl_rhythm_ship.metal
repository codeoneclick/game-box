#include "mtl_common.h"
struct rhythm_vertex {float4 position [[position]];float4 world;float4 color;float3 normal;float2 uv;};
vertex rhythm_vertex vertex_shader_rhythm_ship_solid(common_v_input_t in [[stage_in]],constant common_u_input_t& u [[buffer(1)]]){rhythm_vertex o;float4 p=u.mat_m*float4(in.position,1);o.position=u.mat_p*u.mat_v*p;o.world=float4(p.xyz,max(-(u.mat_v*p).z,.001));o.normal=normalize((u.mat_n*float4(in.normal.xyz,0)).xyz);o.color=in.color;o.uv=in.texcoord;return o;}
vertex rhythm_vertex vertex_shader_rhythm_ship_character(common_v_input_t in [[stage_in]],constant common_u_input_t& u [[buffer(1)]]){rhythm_vertex o;float4 p=u.mat_m*float4(in.position,1);o.position=u.mat_p*u.mat_v*p;o.world=float4(p.xyz,max(-(u.mat_v*p).z,.001));o.normal=normalize((u.mat_n*float4(in.normal.xyz,0)).xyz);o.color=in.color;o.uv=in.texcoord;return o;}
fragment g_buffer_output_t fragment_shader_rhythm_ship_solid(rhythm_vertex in [[stage_in]],constant float4& glow [[buffer(0)]]){float3 n=normalize(in.normal);float light=.42+.58*max(dot(n,normalize(float3(.35,.8,.45))),0.);g_buffer_output_t o;o.color=half4(half3(in.color.rgb*mix(light,1.25+glow.x,in.color.a)),1);o.normal=float4(n*.5+.5,1);o.position=in.world;return o;}
fragment g_buffer_output_t fragment_shader_rhythm_ship_character(rhythm_vertex in [[stage_in]],texture2d<half> image [[texture(0)]]){constexpr sampler point(coord::normalized,address::clamp_to_edge,filter::nearest);half4 c=image.sample(point,in.uv);if(c.a<.5)discard_fragment();g_buffer_output_t o;o.color=half4(c.rgb,1);o.normal=float4(normalize(in.normal)*.5+.5,.5);o.position=in.world;return o;}
